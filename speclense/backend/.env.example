# ===== Copy this file to ".env" and fill in your real values =====

# --- Server ---
PORT=5000
CLIENT_URL=http://localhost:5500

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Database (AWS RDS MySQL) ---
# For local testing you can point these at a local MySQL instance instead.
DB_HOST=your-db-instance.xxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_db_password
DB_NAME=speclense

# --- AWS (S3 for product images, used by admin panel uploads) ---
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=speclense-product-images

# --- Email (forgot password) ---
# Works with AWS SES SMTP credentials, Gmail app password, or any SMTP provider.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass
SMTP_FROM="Speclense <no-reply@yuvi18457@gmail.com>"
